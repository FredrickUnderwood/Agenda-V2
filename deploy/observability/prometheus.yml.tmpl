# Template for prometheus.yml. Render it with your environment's values, e.g.:
#   set -a; source .env; envsubst < prometheus.yml.tmpl > prometheus.yml
# (.env.example has the variables + defaults). The rendered prometheus.yml is
# what docker-compose.yml mounts — don't point the compose at this .tmpl.
global:
  scrape_interval: 15s

scrape_configs:
  - job_name: agenda-gateway
    metrics_path: /-/metrics
    static_configs:
      # Where the gateway's admin endpoints are reachable FROM this Prometheus
      # container. Default assumes the gateway is on the docker host
      # (host.docker.internal, provided via extra_hosts in docker-compose.yml).
      - targets: ["${GATEWAY_TARGET}"]

  # Custom app metrics (sdk/go/metric). The control plane is the single scrape
  # entrypoint — it relays each target's /metrics through that target's
  # agenda-node, so Prometheus never needs direct network reachability to app
  # ports on every machine. Requires observability.prometheus_url +
  # observability.scrape_token to be set as agenda-v2 Settings first.
  - job_name: agenda-app-metrics
    scrape_timeout: 8s
    metrics_path: /api/v1/observability/app-metrics
    authorization:
      credentials: "${SCRAPE_TOKEN}"
    http_sd_configs:
      # Control-plane base URL reachable FROM this Prometheus container.
      - url: ${CONTROL_PLANE_URL}/api/v1/observability/scrape-targets
        refresh_interval: 30s
        authorization:
          credentials: "${SCRAPE_TOKEN}"
    relabel_configs:
      # __address__ starts out as the discovered target's id (see
      # listScrapeTargets); move it into the "target" query param
      # scrapeAppMetrics reads, then point __address__ at the control plane
      # itself — the standard "multi-target exporter" pattern.
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__meta_agenda_app]
        target_label: app
      - source_labels: [__meta_agenda_env]
        target_label: env
      - source_labels: [__meta_agenda_instance]
        target_label: instance
      - target_label: __address__
        replacement: ${CONTROL_PLANE_HOSTPORT}
