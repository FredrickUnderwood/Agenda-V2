# Copy to .env and adjust for your deployment, then render prometheus.yml:
#   set -a; source .env; envsubst < prometheus.yml.tmpl > prometheus.yml

# Where the gateway's /-/metrics is reachable from the Prometheus container.
# host.docker.internal (provided via extra_hosts in docker-compose.yml) points
# at the docker host; change to <host>:<port> if the gateway runs elsewhere.
# 8081 is deploy/quickstart's GATEWAY_PORT default.
GATEWAY_TARGET=host.docker.internal:8081

# Control-plane base URL reachable from the Prometheus container. 8080 is
# deploy/quickstart's CONTROL_PLANE_PORT default.
CONTROL_PLANE_URL=http://host.docker.internal:8080

# host:port form of the same control plane, used as the multi-target exporter
# __address__ replacement. Keep in sync with CONTROL_PLANE_URL.
CONTROL_PLANE_HOSTPORT=host.docker.internal:8080

# The observability.scrape_token agenda-v2 Setting value (bearer token
# Prometheus presents back to the control plane). Any random secret.
SCRAPE_TOKEN=changeme
